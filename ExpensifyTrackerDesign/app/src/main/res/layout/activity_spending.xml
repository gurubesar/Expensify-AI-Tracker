<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tracker"
    android:padding="16dp"
    tools:context=".SpendingActivity">

    <View
        android:id="@+id/headerBg"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:background="@drawable/input"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <ImageButton
        android:id="@+id/imageButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/headerBg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.095"
        app:layout_constraintStart_toStartOf="@id/headerBg"
        app:layout_constraintTop_toTopOf="@id/headerBg"
        app:layout_constraintVertical_bias="0.446"
        app:srcCompat="@drawable/ic_backarrow_name"
        tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

    <TextView
        android:id="@+id/Spendingtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Transactions"
        android:textColor="#FAEC6F"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/headerBg"
        app:layout_constraintEnd_toEndOf="@id/headerBg"
        app:layout_constraintStart_toStartOf="@id/headerBg"
        app:layout_constraintTop_toTopOf="@id/headerBg" />

    <ImageView
        android:id="@+id/imageView5"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/headerBg"
        app:layout_constraintEnd_toEndOf="@id/headerBg"
        app:layout_constraintHorizontal_bias="0.952"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/headerBg"
        app:layout_constraintVertical_bias="0.375"
        app:srcCompat="@drawable/ic_action_name" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/circleContainer"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:transitionName="spending_circle"
        app:layout_constraintBottom_toTopOf="@+id/textView20"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/headerBg"
        app:layout_constraintVertical_bias="0.3">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/spendingProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:indicatorSize="200dp"
            app:trackThickness="12dp"
            app:indicatorColor="#F48A44"
            app:trackColor="#D9D9D9"
            app:trackCornerRadius="10dp"
            android:progress="0"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:orientation="vertical"
            android:gravity="center">

            <LinearLayout
                android:id="@+id/monthContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/tvTransactionMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="This Month"
                    android:textColor="#333"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginStart="2dp"
                    android:alpha="0.7"
                    android:src="@drawable/ic_down_arrow"
                    app:tint="#333" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="In: "
                    android:textSize="12sp"/>
                <TextView
                    android:id="@+id/tvIncomeAmountInside"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RM0.00"
                    android:textColor="#4CAF50"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Out: "
                    android:textSize="12sp"/>
                <TextView
                    android:id="@+id/tvSpentAmountInside"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RM0.00"
                    android:textColor="#E53935"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <View
                android:layout_width="80dp"
                android:layout_height="1dp"
                android:background="#DDD"
                android:layout_marginVertical="6dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Limit"
                android:textSize="11sp"
                android:textColor="#666"/>

            <TextView
                android:id="@+id/tvLimitAmountInside"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RM0.00"
                android:textColor="#000"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <TextView
        android:id="@+id/textView20"
        android:layout_width="204dp"
        android:layout_height="wrap_content"
        android:text="You have Spend total 0% of your limit"
        android:textAlignment="center"
        android:textSize="14sp"
        android:transitionName="spending_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/circleContainer" />

    <TextView
        android:id="@+id/tvMonthlyHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Monthly Transactions"
        android:textColor="#000"
        android:textSize="18sp"
        android:textStyle="bold"
        android:transitionName="spending_header"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView20" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toTopOf="@+id/btnSeeSpending"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvMonthlyHeader">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMonthlyTransactions"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <Button
        android:id="@+id/btnSeeSpending"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="60dp"
        android:background="@drawable/button"
        android:text="See all history"
        android:textAllCaps="false"
        android:textColor="#000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <EditText
        android:id="@+id/editbuttomText2"
        android:layout_width="362dp"
        android:layout_height="49dp"
        android:background="@drawable/input"
        android:clickable="false"
        android:cursorVisible="false"
        android:focusable="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1.0"
        tools:ignore="MissingConstraints,SpeakableTextPresentCheck" />

    <ImageButton
        android:id="@+id/btnDashboard"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="10dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/editbuttomText2"
        app:layout_constraintEnd_toEndOf="@+id/editbuttomText2"
        app:layout_constraintHorizontal_bias="0.05"
        app:layout_constraintStart_toStartOf="@+id/editbuttomText2"
        app:layout_constraintTop_toTopOf="@+id/editbuttomText2"
        app:layout_constraintVertical_bias="0.5"
        app:srcCompat="@drawable/ic_home_name"
        app:tint="#444444"
        tools:ignore="TouchTargetSizeCheck,SpeakableTextPresentCheck" />

    <ImageButton
        android:id="@+id/btnAiChat"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="10dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/editbuttomText2"
        app:layout_constraintEnd_toEndOf="@+id/editbuttomText2"
        app:layout_constraintHorizontal_bias="0.275"
        app:layout_constraintStart_toStartOf="@+id/editbuttomText2"
        app:layout_constraintTop_toTopOf="@+id/editbuttomText2"
        app:layout_constraintVertical_bias="0.5"
        app:srcCompat="@drawable/ic_ai_chat"
        app:tint="#444444"
        tools:ignore="SpeakableTextPresentCheck" />

    <ImageButton
        android:id="@+id/btnAddExpense"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="10dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/editbuttomText2"
        app:layout_constraintEnd_toEndOf="@+id/editbuttomText2"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="@+id/editbuttomText2"
        app:layout_constraintTop_toTopOf="@+id/editbuttomText2"
        app:layout_constraintVertical_bias="0.5"
        app:srcCompat="@android:drawable/ic_input_add"
        app:tint="#444444"
        tools:ignore="SpeakableTextPresentCheck" />

    <ImageButton
        android:id="@+id/btnSpending"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:background="@drawable/bg_nav_active"
        android:padding="10dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/editbuttomText2"
        app:layout_constraintEnd_toEndOf="@+id/editbuttomText2"
        app:layout_constraintHorizontal_bias="0.725"
        app:layout_constraintStart_toStartOf="@+id/editbuttomText2"
        app:layout_constraintTop_toTopOf="@+id/editbuttomText2"
        app:layout_constraintVertical_bias="0.5"
        app:srcCompat="@drawable/ic_money2_name"
        app:tint="#000000"
        tools:ignore="SpeakableTextPresentCheck,TouchTargetSizeCheck" />

    <ImageButton
        android:id="@+id/btnScanner"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="10dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="@+id/editbuttomText2"
        app:layout_constraintEnd_toEndOf="@+id/editbuttomText2"
        app:layout_constraintHorizontal_bias="0.95"
        app:layout_constraintStart_toStartOf="@+id/editbuttomText2"
        app:layout_constraintTop_toTopOf="@+id/editbuttomText2"
        app:layout_constraintVertical_bias="0.5"
        app:srcCompat="@drawable/ic_receipt_name"
        app:tint="#444444"
        tools:ignore="SpeakableTextPresentCheck" />

</androidx.constraintlayout.widget.ConstraintLayout>